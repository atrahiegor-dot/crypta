# ===== Telegram Bot =====
BOT_TOKEN=your_bot_token_here
BOT_USERNAME=your_bot_username

# ===== Database (PostgreSQL) =====
DATABASE_URL=postgresql+asyncpg://tonbot:password@localhost:5432/tonbot
POSTGRES_USER=tonbot
POSTGRES_PASSWORD=password
POSTGRES_DB=tonbot

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== TON Connect =====
# URL where tonconnect-manifest.json is accessible (must be public HTTPS)
TON_CONNECT_MANIFEST_URL=https://yourdomain.com/tonconnect-manifest.json

# ===== Admin =====
# Comma-separated Telegram user IDs with developer role
ADMIN_IDS=123456789,987654321

# ===== XP Settings =====
WALLET_CONNECT_XP=500
REFERRAL_XP=100
DAILY_CHECKIN_BASE_XP=50

# ===== Bot Settings =====
WEBHOOK_ENABLED=false
WEBHOOK_URL=https://yourdomain.com/webhook
WEBHOOK_PORT=8080
